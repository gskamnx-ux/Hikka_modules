import logging
import asyncio
from telethon import Button
from telethon.tl import functions, types
from hikka import module
from hikka.tl import get_entity

logger = logging.getLogger(__name__)

# --- Настройка ---
# В этот список внесите количество звёзд для всех НЕ лимитированных подарков,
# которые не нужно покупать. Используйте только числа.
STARS_TO_IGNORE = [
    15,
    25,
    50,
    100,
]
# -----------------

class StarGiftBuyer(module.Module):
    """
    Автоматически сканирует доступные подарки и покупает те, которых нет в списке исключений.
    """
    
    def __init__(self):
        self.scanning_task = None
        self.is_scanning = False
        
    async def client_ready(self):
        logger.info("Модуль StarGiftBuyer запущен и готов к работе.")
        
    async def on_unload(self):
        if self.scanning_task and not self.scanning_task.done():
            self.scanning_task.cancel()
            logger.info("Задача сканирования была отменена.")

    async def continuous_scan(self, interval_minutes: int):
        """Фоновая задача для непрерывного сканирования."""
        while self.is_scanning:
            try:
                gifts_info = await self.client.invoke(functions.payments.GetStarGifts())
                
                new_gifts_found = []
                for gift in gifts_info.gifts:
                    gift_price = gift.stars
                    
                    # Проверяем, не находится ли цена в списке для игнорирования
                    is_ignored = gift_price in STARS_TO_IGNORE
                    
                    if not is_ignored:
                        new_gifts_found.append(gift)
                
                if new_gifts_found:
                    for gift in new_gifts_found:
                        gift_name = getattr(gift.gift, "title", "Неизвестный подарок")
                        gift_price = gift.stars
                        
                        logger.info(f"Обнаружен новый подарок: {gift_name}. Попытка покупки...")
                        
                        try:
                            result = await self.client.invoke(functions.payments.SendStarsForm(
                                peer=self.client.session.peer,
                                stars_amount=gift_price,
                                currency="XTR",
                                text=f"Покупка подарка {gift_name}"
                            ))
                            
                            if result:
                                logger.info(f"✅ Подарок '{gift_name}' успешно куплен! Сканирование остановлено.")
                                await self.client.send_message("me", f"✅ Подарок '{gift_name}' успешно куплен!")
                                self.is_scanning = False
                                break
                            else:
                                logger.warning(f"❌ Не удалось купить подарок '{gift_name}'.")

                        except Exception as e:
                            logger.error(f"❌ Ошибка при покупке '{gift_name}': {e}")
                            await asyncio.sleep(60)
                            
                await asyncio.sleep(interval_minutes * 60)
                
            except asyncio.CancelledError:
                raise
            except Exception as e:
                logger.error(f"Произошла ошибка в фоновой задаче: {e}")
                await asyncio.sleep(interval_minutes * 60)

    async def cmd_start_scan(self, message: types.Message, args: str):
        """
        .start_scan [интервал_в_минутах]
        Запускает непрерывное сканирование. Интервал по умолчанию: 5 минут.
        Пример: .start_scan 10
        """
        if self.is_scanning:
            await self.client.send_message(message.peer_id, "ℹ️ Сканирование уже запущено.")
            return

        interval_minutes = 5
        if args:
            try:
                interval_minutes = int(args)
                if interval_minutes <= 0:
                    raise ValueError
            except ValueError:
                await self.client.send_message(message.peer_id, "❌ Неверный интервал. Укажите число в минутах.")
                return

        self.is_scanning = True
        self.scanning_task = asyncio.create_task(self.continuous_scan(interval_minutes))
        
        await self.client.send_message(
            message.peer_id,
            f"✅ Сканирование запущено! Интервал: **{interval_minutes}** минут."
        )

    async def cmd_stop_scan(self, message: types.Message):
        """
        .stop_scan
        Останавливает непрерывное сканирование.
        """
        if not self.is_scanning:
            await self.client.send_message(message.peer_id, "ℹ️ Сканирование не запущено.")
            return

        self.is_scanning = False
        if self.scanning_task:
            self.scanning_task.cancel()
        
        await self.client.send_message(message.peer_id, "✅ Сканирование остановлено.")
